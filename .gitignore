#
# .gitignore: Keep local tools, credentials, and generated output untracked.
#

# Disposable developer environments and caches.
.venv/
venv/
node_modules/
__pycache__/
*.py[cod]
.ruff_cache/
.pytest_cache/
.pre-commit-cache/
coverage.xml
.coverage

# Local operating-system files, logs, and existing private data.
.DS_Store
*.log
python/metadata/test/
config*.yml
!.github/ISSUE_TEMPLATE/config.yml
.env
.env.*
!.env.example
