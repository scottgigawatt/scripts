set filen to "/tmp/line-" &amp; (time of (current date)) &amp; ".jpg"

do shell script "printf %s " &amp; quoted form of base64line &amp; " | tr -d '\\r\\n' | /usr/bin/openssl enc -base64 -d -A &gt; " &amp; quoted form of filen

set the clipboard to (read (POSIX file filen) as JPEG picture)
delay 0.2
tell application "System Events" to keystroke "v" using {command down}
do shell script "rm -f " &amp; quoted form of filen</string>
